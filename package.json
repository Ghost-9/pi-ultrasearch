{
  "name": "pi-ultrasearch",
  "version": "0.3.1",
  "description": "Ultra-fast whole-disk filesystem search, trigram grep, and git-aware code indexing extension for Pi Agent, Antigravity & T3 Code, backed by the resident ultrasearch daemon.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ghost-9/pi-ultrasearch.git"
  },
  "homepage": "https://github.com/Ghost-9/pi-ultrasearch#readme",
  "bugs": {
    "url": "https://github.com/Ghost-9/pi-ultrasearch/issues"
  },
  "bin": {
    "ultrasearch": "./dist/bin/cli.js",
    "ultrasearch-tui": "./dist/bin/tui.js",
    "ultrasearch-mcp": "./dist/bin/mcp-server.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "index.ts",
    "type-stubs.d.ts",
    "engine/rebrand.sh",
    "scripts/install.sh",
    "scripts/install-extension.sh",
    "scripts/verify-fda.sh",
    "scripts/us-rg",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "ROADMAP.md",
    "OPTIMIZATIONS.md",
    "AUDIT-2026-10-14.md",
    "CONTRIBUTING.md",
    "NOTICE",
    "LICENSE",
    "packaging"
  ],
  "pi": {
    "extensions": [
      "index.ts"
    ]
  },
  "scripts": {
    "bench": "node test/bench.ts",
    "bench:boost": "node bench/boost.mjs",
    "bench:engine": "node bench/engine-ab.mjs",
    "bench:fallback": "node bench/fallback.mjs",
    "bench:lanes": "node bench/lanes.mjs",
    "bench:report": "node bench/report.mjs",
    "bench:scopes": "node bench/run.mjs",
    "bench:scopes:json": "node bench/run.mjs --json",
    "bench:tokens": "node bench/tokens.mjs",
    "bench:wave3:audit": "node bench/wave3/expectation-audit.mjs",
    "bench:wave3:compare": "node bench/wave3/compare.mjs",
    "bench:wave3:corpora": "node bench/wave3/make-corpora.mjs",
    "bench:wave3:identity": "node bench/wave3/identity-cli-mcp.mjs",
    "bench:wave3:measure": "node bench/wave3/measure.mjs",
    "bench:wave3:work": "node bench/wave3/work-probe.mjs",
    "build": "tsc -p tsconfig.build.json",
    "codemode:declarations": "node bin/gen-codemode-declarations.ts",
    "metrics:nightly": "node bench/nightly-summary.mjs",
    "prepack": "npm run build",
    "release:artifact": "node bench/release-artifact.mjs",
    "test": "node --test test/client.test.ts test/sanitize.test.ts test/config-edit.test.ts test/harness-init.test.ts test/harness-matrix.test.ts test/mcp.test.ts test/client-features.test.ts test/ipc-lanes.test.ts test/fallback.test.ts test/telemetry-views.test.ts test/telemetry-harness.test.ts test/telemetry-logs.test.ts test/single-instance-client.test.ts test/e2e-regressions.test.ts test/interop-surface.test.ts test/roots.test.ts test/history.test.ts test/watch.test.ts test/prefetch.test.ts test/cli-interop.test.ts test/ranking-guard.test.ts test/packaging.test.ts test/tool-descriptions.test.ts test/policy.test.ts test/exact-query-scope.test.ts test/corpus-meta-isolation.test.ts test/semantic-opt-in.test.ts",
    "test:all": "npm run typecheck && npm test && npm run test:gate && npm run test:engine",
    "test:empirical": "node --test test/empirical-10-tests.ts",
    "test:engine": "node --test --test-concurrency=1 test/engine/*.test.mjs",
    "judgments:integrity": "node bench/verification/checks/judgment-integrity.mjs",
    "judgments:integrity:test": "node --test bench/verification/checks/judgment-integrity.test.mjs",
    "test:gate": "node --test test/benchmark-gate.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "bench:wave4:judgments": "node bench/wave4/make-judgments-v2.mjs",
    "bench:wave4:probe": "node bench/wave4/probe-companions.mjs",
    "bench:wave4:validate": "node bench/wave4/validate-judgments.mjs",
    "bench:wave4:validate:test": "node --test bench/wave4/validate-judgments.test.mjs",
    "bench:wave4:gates": "bash bench/wave4/run-gates.sh",
    "smoke:harness": "node bench/harness-smoke.mjs",
    "matrix:harness": "node bench/harness-matrix.mjs"
  },
  "keywords": [
    "pi-agent",
    "antigravity",
    "t3-code",
    "pi-ultrasearch",
    "ultrasearch",
    "ultrasearch-tui",
    "search",
    "grep",
    "ripgrep",
    "tantivy",
    "fast-search",
    "codemode",
    "mcp",
    "observability",
    "recursive-learning"
  ],
  "author": "Ghost-9",
  "license": "AGPL-3.0-or-later",
  "peerDependencies": {
    "typebox": ">=0.34"
  },
  "peerDependenciesMeta": {
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
